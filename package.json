{
  "name": "freemd",
  "version": "0.1.7",
  "description": "Local markdown notes editor in your browser and export. Run with npx freemd",
  "license": "MIT",
  "type": "module",
  "bin": {
    "freemd": "bin/freemd.js"
  },
  "files": [
    "bin",
    "server",
    "dist",
    "README.es.md",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node bin/freemd.js --no-open",
    "build": "vite build",
    "start": "node bin/freemd.js"
  },
  "dependencies": {
    "docx": "^9.14.0",
    "express": "^4.21.2",
    "highlight.js": "^11.10.0",
    "image-size": "^2.0.4",
    "markdown-it": "^14.1.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.2",
    "markdown-it-highlightjs": "^4.1.0",
    "svelte": "^5.16.0",
    "vite": "^5.4.11"
  },
  "keywords": [
    "markdown",
    "notes",
    "editor",
    "svelte",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public"
  }
}
